# ツールやAIの設定フォルダ
.claude/

# 巨大なインストーラーやISOファイルは除外
*.iso
*.exe
*.msi
*.dll

# 上記グローバル除外への例外（リポジトリで管理する同梱バイナリ）
# - Fabriq.exe           : 自社製ランチャー（dev/launcher/Launcher.cs ビルド成果物）
# - Fabriq_IOS.exe       : fabriq_ios サブプロジェクト用ランチャー（dev/launcher/Launcher_IOS.cs ビルド成果物）
# - Fabriq_BackUper.exe  : fabriq_backuper satellite 用ランチャー（dev/launcher/Launcher_BackUper.cs ビルド成果物）
# - 7z.exe / 7z.dll : 7-Zip 25.01 (x64) を printer_driver_config 用に同梱
#   ライセンス情報は THIRD_PARTY_NOTICES.md および LICENSES/ 参照
!/Fabriq.exe
!/Fabriq_IOS.exe
!/Fabriq_BackUper.exe
!/modules/standard/printer_driver_config/tools/7z.exe
!/modules/standard/printer_driver_config/tools/7z.dll

# 特定のフォルダの中身をまるごと除外
/modules/standard/driver_config/driver/*
!/modules/standard/driver_config/driver/.gitkeep

/modules/standard/printer_driver_config/INF/*
!/modules/standard/printer_driver_config/INF/命名規則.txt
!/modules/standard/printer_driver_config/INF/.gitkeep

/evidence/export_history/*
!/evidence/export_history/.gitkeep

/evidence/gyotaku/*
!/evidence/gyotaku/.gitkeep

/logs/*
!/logs/.gitkeep

/logs/history/*
!/logs/history
!/logs/history/.gitkeep



# AppxBundle パッケージ（HEIF/HEVC拡張等）
*.AppxBundle

# バックアップファイル
*.bak

# 壁紙画像ファイル
/modules/standard/wallpaper_config/wallpaper/*
!/modules/standard/wallpaper_config/wallpaper/.gitkeep

# ランチャーアイコン素材（画像ファイルのみ無視、ソースは追跡）
/dev/ico/*.ico
/dev/ico/*.png
/dev/ico/*.jpg
/dev/ico/*.jpeg
/dev/ico/*.bmp
/dev/ico/*.gif

# 一時ファイルやキャッシュ
*.tmp
*.log

# ランタイム生成物（Fabriq 実行中に書き出される状態ファイル）
/kernel/json/art_pulse.txt
/kernel/json/skip_request.flag

# Telemetry (AI 開発コーパス、site-specific salt)
# logs/telemetry/ 自体は /logs/* で既に追跡対象外。
# salt は環境ごとに自動生成され、commit してはいけない。
/kernel/json/telemetry_salt.txt

# NOTE: kernel/json/verbose_capture.flag is INTENTIONALLY tracked
# (standard deployment ships with verbose capture ON by default).
# Removing the file is the documented opt-out path.